---
import Layout from '@/layouts/Layout.astro';
import ArrowUpRight from 'lucide-astro/ArrowUpRight';
---

<Layout title="Página no encontrada | Aliza Seguros">
  <section class="min-h-[80vh] flex items-center justify-center bg-white px-6">
    
    <div class="max-w-2xl w-full text-center">
      
      <!-- Código -->
      <p class="text-sm tracking-widest text-red-600 font-semibold mb-4">
        ERROR 404
      </p>

      <!-- Título -->
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Página no encontrada
      </h1>

      <!-- Descripción -->
      <p class="text-lg text-gray-600 mb-10 leading-relaxed">
        La página que estás buscando no existe o fue movida.  
        Si necesitas gestionar tu SCTR o cotizar rápidamente, puedes volver al inicio y continuar sin complicaciones.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        
      <a 
        href="/Contacto" 
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#B61F1F] text-white px-10 py-5 font-bold text-base transition-all rounded-lg hover:bg-black"
      >
        Cotizar mi SCTR Ahora
        <ArrowUpRight size={20} class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
      </a>

      </div>

      <!-- Extra confianza -->
      <div class="mt-12 text-sm text-gray-500">
        <p>Atención rápida • Gestión digital • Cumplimiento SUNAFIL</p>
      </div>

    </div>
  </section>
</Layout>