---
// src/components/Hero.astro
import { ArrowUpRight } from 'lucide-astro';
import Whatsapp from './icons/whatsapp.astro';
---
<section class="relative min-h-screen flex items-center pt-24 overflow-hidden bg-black">
  <div class="absolute inset-0 z-0">
    <img 
      src="/img/AlizaSegurosHero.webp" 
      alt="Aliza Seguros SCTR Perú" 
      class="w-full h-full object-cover object-bottom-right md:object-center opacity-60"
    />
    <div class="absolute inset-0 bg-linear-to-r from-black via-black/90 to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-2xl">
      
      <div class="inline-flex items-center gap-2.5 bg-white/5 border border-white/10 px-4 py-2 rounded-[5px] mb-8">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em]">Para empresas de alto riesgo en Perú</span>
      </div>

      <h1 class="text-5xl md:text-7xl font-bold text-white leading-[1.05] mb-6 tracking-tighter">
        Obtén tu <span class="text-[#B61F1F]">SCTR</span> hoy y trabaja sin riesgo de multas.
      </h1>

      <p class="text-lg text-gray-400 mb-10 max-w-lg leading-relaxed font-light">
        Emisión rápida, asesoría clara y cumplimiento total para que puedas ingresar a obra sin preocupaciones.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#cotizar" class="inline-flex items-center justify-center gap-2 bg-[#B61F1F] text-white px-8 py-4 font-bold text-base hover:bg-[#961a1a] transition-all rounded-[5px] shadow-xl shadow-red-950/30">
          Cotizar mi SCTR Ahora
          <ArrowUpRight size={20} strokeWidth={2.5} />
        </a>
        
        <a href="https://wa.me/+51917410446" target="_blank" class="inline-flex items-center justify-center gap-3 border border-white/20 bg-white/5 backdrop-blur-sm text-white px-8 py-4 font-bold text-base hover:bg-white/10 transition-all rounded-[5px]" aria-label="Ir a WhatsApp">
          Hablar Por WhatsApp
          <Whatsapp class="w-5 h-5" />
        </a>
      </div>

    </div>
  </div>
</section>