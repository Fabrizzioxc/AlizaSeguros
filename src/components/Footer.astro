---
import Facebook from "../components/icons/facebook.astro";
import Whatsapp from "../components/icons/whatsapp.astro";
import Tiktok from "../components/icons/tiktok.astro";
import Instagram from "../components/icons/instagram.astro";

interface Props {
  email?: string;
  phone?: string;
  address?: string;
}

const {
  email = 'a.lizaseguros@gmail.com',
  phone = '+51 917 410 446',
  address = 'Jacaranda 191, Lima'
} = Astro.props;
---

<footer class="w-full bg-white mt-auto px-5 py-0">
  <div class="max-w-8xl mx-auto bg-[#121212] px-10 py-12 md:px-12 md:py-16 lg:px-16 lg:py-20 rounded-t-[45px]">
    
    <div class="flex flex-col md:flex-row justify-between gap-12">
      
      <div class="flex-1 max-w-sm text-center md:text-left">
        <span class="text-2xl font-bold text-white tracking-tight">
          Aliza <span class="text-[#B61F1F]">Seguros</span>
        </span>
        <p class="mt-4 text-gray-400 text-sm leading-relaxed">
          Brindamos soluciones integrales en seguros SCTR para empresas e independientes, garantizando la protección que tu equipo necesita con el respaldo de expertos.
        </p>
        
        <div class="flex gap-3 mt-6 justify-center md:justify-start">
          <a
            href="https://wa.me/51917410446"
            target="_blank"
            class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#B61F1F]/20 hover:border-[#B61F1F]/40 transition-all"
            aria-label="Contactar por WhatsApp"
          >
            <Whatsapp class="w-5 h-5" />
          </a>

          <a
            href="https://www.facebook.com/profile.php?id=100086219962154"
            target="_blank"
            rel="noopener noreferrer" 
            aria-label="Visitar nuestra página de Facebook"
            class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#B61F1F]/20 hover:border-[#B61F1F]/40 transition-all"
          >
            <Facebook class="w-5 h-5" />
          </a>

          <a
            href="https://www.instagram.com/alizaseguros/"
            target="_blank"
            rel="noopener noreferrer" 
            aria-label="Visitar nuestra página de Instagram"
            class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#B61F1F]/20 hover:border-[#B61F1F]/40 transition-all"
          >
            <Instagram class="w-5 h-5" />
          </a>

          <a
            href="https://www.tiktok.com/@alizaseguros?is_from_webapp=1&sender_device=pc"
            target="_blank"
            rel="noopener noreferrer" 
            aria-label="Visitar nuestra página de TikTok"
            class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#B61F1F]/20 hover:border-[#B61F1F]/40 transition-all"
          >
            <Tiktok class="w-5 h-5" />
          </a>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-12 text-center md:text-left">
        
        <nav class="flex flex-col gap-4">
          <span class="text-[#B61F1F] font-bold uppercase tracking-widest text-xs mb-2">Servicios</span>
          <a href="#empresas" class="text-sm text-gray-300 hover:text-[#B61F1F] transition">SCTR Empresas</a>
          <a href="#independientes" class="text-sm text-gray-300 hover:text-[#B61F1F] transition">SCTR Independientes</a>
          <a href="#que-es" class="text-sm text-gray-300 hover:text-[#B61F1F] transition">¿Qué es?</a>
          <a href="/Contacto" class="text-sm text-gray-300 hover:text-[#B61F1F] transition">Contacto</a>
        </nav>

        <div class="flex flex-col gap-4">
          <span class="text-[#B61F1F] font-bold uppercase tracking-widest text-xs mb-2">Contacto</span>
          <div class="space-y-3 text-sm text-gray-300 flex flex-col items-center md:items-start">
            <a href={`mailto:${email}`} class="hover:text-[#B61F1F] transition">
              {email}
            </a>
            <a href={`tel:${phone}`} class="hover:text-[#B61F1F] transition">
              {phone}
            </a>
            <span class="max-w-37.5">{address}</span>
          </div>
        </div>

      </div>
    </div>

    <div class="h-px bg-white/10 my-8"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-400">
      <p class="m-0">© Desarrollado por Fabrizzio Zambrano</p>
      <a href="/politicas-privacidad" class="hover:text-[#B61F1F] transition">
        Políticas de privacidad
      </a>
    </div>

  </div>
</footer>