---
// src/components/Header.astro
import { Menu } from "lucide-astro";
const isHome = Astro.url.pathname === "/";
---

<header 
  id="site-header"
  class={`fixed top-0 left-0 w-full z-50 tracking-tight transition-all duration-300 ${
    isHome 
      ? "bg-transparent border-transparent backdrop-blur-none" 
      : "bg-[#121212] border-white/10 backdrop-blur-xl"
  }`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <span class="text-white font-bold text-lg uppercase tracking-tighter">
        Aliza <span class="text-[#B61F1F]">Seguros</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-10 text-[13px] uppercase font-semibold tracking-widest text-gray-300">
      <a href="/SCTREmpresas" class="hover:text-[#B61F1F] transition-colors">Empresas</a>
      <a href="/SCTRIndependientes" class="hover:text-[#B61F1F] transition-colors">Independientes</a>
      <a href="/QueEsSCTR" class="hover:text-[#B61F1F] transition-colors">¿Qué es?</a>
    </nav>

    <!-- Desktop CTA -->
    <a 
      href="/Contacto" 
      class="hidden md:inline-flex bg-[#B61F1F] hover:bg-[#961a1a] text-white px-7 py-2.5 font-bold text-sm transition-all rounded-[5px]"
    >
      Contáctanos
    </a>

    <!-- Mobile Button -->
    <button 
      id="menu-btn"
      class="md:hidden text-white"
      aria-label="Abrir menú"
    >
      <Menu size={26} />
    </button>
  </div>

  <!-- Mobile Menu -->
  <div 
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/10 transition-all duration-300"
  >
    <div class="flex flex-col px-6 py-6 gap-6 text-sm uppercase font-semibold tracking-widest text-gray-300">
      
      <a href="/SCTREmpresas" class="hover:text-[#B61F1F] transition-colors">Empresas</a>
      <a href="/SCTRIndependientes" class="hover:text-[#B61F1F] transition-colors">Independientes</a>
      <a href="/QueEsSCTR" class="hover:text-[#B61F1F] transition-colors">¿Qué es?</a>

      <a 
        href="/Contacto"
        class="mt-4 bg-[#B61F1F] hover:bg-[#961a1a] text-white px-6 py-3 text-center font-bold rounded-[5px]"
      >
        Contáctanos
      </a>
    </div>
  </div>
</header>

<!-- Script simple para toggle -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const header = document.getElementById("site-header");

    const isHome = window.location.pathname === "/";

    btn?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
    });

    let ticking = false;

    const handleScroll = () => {
      if (!header || !menu) return;

      const scrolled = window.scrollY > 80;

      if (isHome) {
        if (scrolled) {
          header.classList.add("bg-[#121212]", "border-white/10", "backdrop-blur-xl");
          header.classList.remove("bg-transparent", "border-transparent");

          menu.classList.add("bg-[#121212]");
          menu.classList.remove("bg-black/40");
        } else {
          header.classList.add("bg-transparent", "border-transparent");
          header.classList.remove("bg-[#121212]", "border-white/10");

          menu.classList.add("bg-black/40", "backdrop-blur-xl");
          menu.classList.remove("bg-[#121212]");
        }
      }
    };

    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    handleScroll();
  });
</script>