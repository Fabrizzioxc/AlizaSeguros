---
import { ArrowUpRight, MessageCircle } from 'lucide-astro';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img 
      src="/img/sctr-trabajadores-independientes-contratistas-peru.webp" 
      alt="Profesional independiente trabajando en oficina moderna con laptop y planos" 
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/60 backdrop-blur-[1px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 text-center">
    
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/30 bg-white/10 backdrop-blur-md mb-8">
      <div class="w-5 h-5 bg-white/20 rounded-full flex items-center justify-center text-white">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <span class="text-white text-sm font-medium tracking-wide">
        Para profesionales independientes
      </span>
    </div>

    <h1 class="text-white text-4xl md:text-7xl font-extrabold mb-6 leading-[1.1] tracking-tight max-w-5xl mx-auto">
      Trabaja en cualquier obra <span class="text-[#B61F1F] drop-shadow-md">sin complicaciones</span>
    </h1>

    <p class="text-white/80 text-lg md:text-xl mb-12 max-w-3xl mx-auto leading-relaxed">
      Obtén tu SCTR personal en horas. Sin empleador, sin letra pequeña. <br class="hidden md:block" />
      Solo tú, tu seguro y la libertad de trabajar donde quieras.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
      <a 
        href="/Contacto" 
        class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#B61F1F] hover:bg-[#961a1a] text-white px-10 py-5 font-bold text-base transition-all rounded-[5px] shadow-xl shadow-red-900/20"
      >
        Cotizar mi SCTR Ahora
        <ArrowUpRight size={22} class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
      </a>

      <a 
        href="https://wa.me/+51917410446" 
        target="_blank" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 border border-white/20 bg-white/5 backdrop-blur-sm text-white px-8 py-5 font-bold text-base hover:bg-white/10 transition-all rounded-[5px]"
      >
        Hablar Por WhatsApp
        <MessageCircle class="w-5 h-5 fill-white/10" />
      </a>
    </div>

  </div>
</section>

<style>
  h1 {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  
  /* Efecto de glow para el texto destacado en rojo */
  .text-\[\#B61F1F\] {
    text-shadow: 0 0 30px rgba(182, 31, 31, 0.35);
  }
</style>