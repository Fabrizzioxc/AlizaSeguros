---
import Badge from "../Badge.astro";
import { ShieldCheck, Zap, CalendarCheck, Banknote } from "lucide-astro";

const features = [
  {
    title: "Cumplimiento SUNAFIL",
    description: "Blindaje legal total con póliza, evitando multas graves y protegiendo tu patrimonio.",
    icon: ShieldCheck,
  },
  {
    title: "Rapidez en la atención",
    description: "Activamos la cobertura de tu personal nuevo al instante para garantizar su ingreso a obra.",
    icon: Zap,
  },
  {
    title: "Renovación automática",
    description: "Te avisamos antes del vencimiento para no tener brechas de cobertura.",
    icon: CalendarCheck,
  },
  {
    title: "Costos optimizados",
    description: "Comparamos entre aseguradoras para darte la mejor tarifa grupal.",
    icon: Banknote,
  },
];
---

<section class="max-w-7xl mx-auto px-6 py-20">
  <div class="mb-16">
    <Badge text="¿Por qué Aliza Seguros Corporativo?" variant="default" className="mb-6" />
    <h2 class="text-4xl md:text-6xl font-extrabold text-black leading-[1.1] tracking-tight max-w-3xl">
      Blindaje total y agilidad digital para tu operación.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      features.map((item) => (
        <div class="group relative bg-[#F9F9F9] border border-black/3 rounded-[12px] p-10 md:p-14 transition-all duration-500 hover:bg-white hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)] hover:-translate-y-1">
          
          <div class="mb-8 inline-block text-black transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3">
            <item.icon size={48} strokeWidth={1.5} />
          </div>

          <div class="space-y-4">
            <h3 class="text-2xl md:text-3xl font-bold text-black tracking-tight">
              {item.title}
            </h3>
            <p class="text-gray-500 text-lg leading-relaxed max-w-100">
              {item.description}
            </p>
          </div>

          <div class="absolute top-8 right-8 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
            <div class="w-2 h-2 rounded-full bg-[#B61F1F]"></div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Tipografía Bricolage para el título principal */
  h2 {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  
  /* Inter para el cuerpo de las cards para mejor legibilidad corporativa */
  h3, p {
    font-family: 'Inter', system-ui, sans-serif;
  }
</style>