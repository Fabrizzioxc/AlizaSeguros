---
import Badge from "../Badge.astro";
import { Building2, UserCheck, ArrowRight } from "lucide-astro";
---

<section class="bg-white py-12 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="flex flex-col items-center text-center mb-20">
      <Badge 
        text="Soluciones a medida" 
        variant="default" 
        size="sm" 
        className="mb-8 border-black/5 bg-gray-50 text-black/60" 
      />
      <h2 class="text-4xl md:text-6xl font-extrabold text-black tracking-tighter leading-[1.1]">
        Obtén tu SCTR según <br class="hidden md:block" /> 
        <span class="text-[#B61F1F]">cómo trabajas</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      
      <a href="/SCTREmpresas" class="group relative block h-[600px] rounded-[8px] overflow-hidden border border-gray-100 shadow-2xl transition-all duration-500 hover:shadow-red-900/10">
        <img 
          src="/img/sctr-para-empresas-peru.webp" 
          alt="SCTR para empresas en Perú" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
        
        <div class="absolute bottom-0 left-0 right-0 p-10 md:p-14 flex flex-col items-start space-y-6">
          <div class="w-16 h-16 bg-[#B61F1F] rounded-2xl flex items-center justify-center text-white shadow-xl">
            <Building2 size={32} />
          </div>
          <div>
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">Empresas</h3>
            <p class="text-white/70 text-lg leading-relaxed max-w-sm">
              Asegura a todo tu personal y cumple con la normativa para operar sin riesgos ni sanciones.
            </p>
          </div>
          <div class="flex items-center gap-3 text-white font-bold group-hover:gap-5 transition-all">
            <span>Ver planes corporativos</span>
            <ArrowRight size={20} class="text-[#B61F1F]" />
          </div>
        </div>
      </a>

      <a href="/SCTRIndependientes" class="group relative block h-[600px] rounded-[8px] overflow-hidden border border-gray-100 shadow-2xl transition-all duration-500 hover:shadow-red-900/10">
        <img 
          src="/img/sctr-para-independientes-peru.webp" 
          alt="SCTR para trabajadores independientes en Perú" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
        
        <div class="absolute bottom-0 left-0 right-0 p-10 md:p-14 flex flex-col items-start space-y-6">
          <div class="w-16 h-16 bg-[#B61F1F] rounded-2xl flex items-center justify-center text-white shadow-xl">
            <UserCheck size={32} />
          </div>
          <div>
            <h3 class="text-3xl md:text-4xl font-bold text-white mb-4">Independientes</h3>
            <p class="text-white/70 text-lg leading-relaxed max-w-sm">
              Obtén tu SCTR personal en horas y trabaja en cualquier proyecto sin restricciones ni empleador.
            </p>
          </div>
          <div class="flex items-center gap-3 text-white font-bold group-hover:gap-5 transition-all">
            <span>Obtener mi SCTR personal</span>
            <ArrowRight size={20} class="text-[#B61F1F]" />
          </div>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  h2, h3 {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
  }
  p, span {
    font-family: 'Inter', system-ui, sans-serif;
  }
</style>