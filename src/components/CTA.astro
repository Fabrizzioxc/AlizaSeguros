---
import { ArrowUpRight } from 'lucide-astro';
---

<section class="max-w-8xl mx-auto px-4 py-12 md:py-20">
  <div class="bg-[#B61F1F] rounded-2xl p-8 md:p-24 flex flex-col items-center text-center">
    
    <h2 class="text-white text-3xl md:text-6xl font-extrabold mb-6 md:mb-10 leading-[1.1] tracking-tight max-w-5xl italic-custom">
      Protege a tu equipo y <br class="hidden md:block" /> asegura el futuro de tu empresa hoy
    </h2>

    <p class="text-white/90 text-base md:text-xl mb-10 md:mb-14 max-w-2xl font-medium">
      Obtén tu SCTR corporativo en minutos con el respaldo de Aliza Seguros.
    </p>

    <a 
      href="/Contacto" 
      class="group w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#121212] hover:bg-[#1a1a1a] text-white px-8 md:px-16 py-5 font-bold text-base transition-all rounded-[5px] shadow-2xl shadow-black/20"
    >
      Contactar con un asesor
      <ArrowUpRight 
        size={22} 
        strokeWidth={2.5}
        class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" 
      />
    </a>

  </div>
</section>